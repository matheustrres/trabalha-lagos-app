{
  "name": "trabalha-lagos",
  "version": "1.0.0",
  "description": "",
  "author": "Matheus Torres <matheustrres.rj@gmail.com>",
  "license": "MIT",
  "private": "true",
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --parallel --filter @trabalha-lagos/api --filter @trabalha-lagos/client run dev",
    "dev:api": "pnpm --filter @trabalha-lagos/api run dev",
    "dev:client": "pnpm --filter @trabalha-lagos/client run dev",
    "dev:infra": "docker compose --env-file apps/api/.env.dev -f apps/api/docker-compose.yml up -d",
    "dev:infra:down": "docker compose --env-file apps/api/.env.dev -f apps/api/docker-compose.yml down",
    "lint:api": "pnpm --filter @trabalha-lagos/api run lint:fix && pnpm --filter @trabalha-lagos/api run format",
    "lint:client": "pnpm --filter @trabalha-lagos/client run lint",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.0"
  }
}
